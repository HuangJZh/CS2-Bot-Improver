<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BotAimImprover</RootNamespace>
    <AssemblyName>BotAimImprover</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" Condition="'$(CounterStrikeSharpApiPath)' == ''" />
    <Reference Include="$(CounterStrikeSharpApiPath)/*.dll" Condition="'$(CounterStrikeSharpApiPath)' != ''"><Private>false</Private></Reference>
    <Reference Include="BotControllerApi"><HintPath>$(CounterStrikeSharpApiPath)/../shared/BotControllerApi/BotControllerApi.dll</HintPath><Private>false</Private></Reference>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="preaim-points.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="preaim-nodes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="navigation/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
