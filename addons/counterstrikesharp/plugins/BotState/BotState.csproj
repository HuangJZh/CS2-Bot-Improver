<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" Condition="'$(CounterStrikeSharpApiPath)' == ''" />
    <Reference Include="$(CounterStrikeSharpApiPath)/*.dll" Condition="'$(CounterStrikeSharpApiPath)' != ''"><Private>false</Private></Reference>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BotControllerApi">
      <HintPath>$(CounterStrikeSharpApiPath)/../shared/BotControllerApi/BotControllerApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
