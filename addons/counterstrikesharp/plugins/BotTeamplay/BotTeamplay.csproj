<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(CounterStrikeSharpApiDir)' == ''">
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
  </ItemGroup>
  <ItemGroup Condition="'$(CounterStrikeSharpApiDir)' != ''">
    <Reference Include="$(CounterStrikeSharpApiDir)/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
</Project>
