<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
 <ItemGroup>
  <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" Condition="'$(CounterStrikeSharpApiPath)' == ''" />
  <Reference Include="$(CounterStrikeSharpApiPath)/*.dll" Condition="'$(CounterStrikeSharpApiPath)' != ''"><Private>false</Private></Reference>
  <Compile Remove="tests/**/*.cs" />
  <None Include="source/InventorySimulator/lang/**" Link="lang/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
 </ItemGroup>
</Project>
